# En Render, configura estas variables desde el panel Environment.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_AT_LEAST_14_CHARACTERS
MCP_API_KEY=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app
API_PUBLIC_URL=https://YOUR-API.onrender.com
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
# Stable, private base64-encoded 32 random bytes. Back it up; keep it across deploys.
NOTIFICATION_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# The administrator also enables delivery in Settings after checking the production URL.
EMAIL_DELIVERY_ENABLED=true
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:10000
BREVO_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET
NOTIFICATION_LEGACY_ENCRYPTION_KEYS=
